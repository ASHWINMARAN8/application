<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:padding="16dp">

    <!-- Top Telemetry Header -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_brand_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AMAZON ECHO SUITE // EDGE AI"
                android:textColor="@color/alexa_primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIU CORE OS"
                android:textColor="@color/text_white"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Persona Switch Button (Echo Core <-> Echo Show) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_persona_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SWITCH: SHOW"
            android:textSize="11sp"
            android:textColor="@color/bg_black"
            app:backgroundTint="@color/alexa_primary"
            app:cornerRadius="20dp" />

    </LinearLayout>

    <!-- Sub Status Line -->
    <LinearLayout
        android:id="@+id/sub_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <TextView
            android:id="@+id/tv_system_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 100% OFFLINE // ZERO DATA"
            android:textColor="@color/status_green"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_language_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="TRILINGUAL: ENG / தமிழ் / TANGLISH"
            android:textColor="@color/alexa_accent"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Central Echo Light Ring Core Container -->
    <FrameLayout
        android:id="@+id/arc_reactor_container"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/sub_status_bar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Outer Glowing Echo Ring -->
        <View
            android:id="@+id/ring_outer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_circle_ring" />

        <!-- Inner Echo Speaker Core Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_arc_core"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_gravity="center"
            app:cardCornerRadius="65dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="#0D1B2D">

            <ImageView
                android:id="@+id/iv_mic_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="@color/alexa_primary" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <TextView
        android:id="@+id/tv_wake_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Say 'Siu' / 'சியு' or Tap Core Ring"
        android:textColor="@color/text_muted"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/arc_reactor_container"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Audio / Voice Status Ticker -->
    <TextView
        android:id="@+id/tv_speech_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="SIU STANDBY"
        android:textColor="@color/alexa_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tv_wake_hint"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Dialogue Bubble / Transcript -->
    <LinearLayout
        android:id="@+id/dialogue_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="12dp"
        android:background="#160D1D30"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_speech_state">

        <TextView
            android:id="@+id/tv_user_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You: 'Siu, brightness kootu' / 'Siu, wifi settings open pannu'"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_ai_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="SIU: Hello! Complete device settings & hardware control 100% offline."
            android:textColor="@color/text_white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Telemetry Cards (Torch, Volume, Brightness, Battery) -->
    <LinearLayout
        android:id="@+id/status_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/dialogue_container">

        <TextView
            android:id="@+id/card_torch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#0D1A2A"
            android:padding="8dp"
            android:gravity="center"
            android:text="🔦 TORCH"
            android:textColor="@color/alexa_primary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/card_volume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="#0D1A2A"
            android:padding="8dp"
            android:gravity="center"
            android:text="🔊 65%"
            android:textColor="@color/alexa_primary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/card_brightness"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="#0D1A2A"
            android:padding="8dp"
            android:gravity="center"
            android:text="🔆 75%"
            android:textColor="@color/alexa_primary"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/card_battery"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="#0D1A2A"
            android:padding="8dp"
            android:gravity="center"
            android:text="🔋 88%"
            android:textColor="@color/alexa_primary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Accessibility / Background Service Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_enable_accessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="ENABLE FULL DEVICE CONTROL (ACCESSIBILITY)"
        android:textSize="11sp"
        android:textColor="@color/text_white"
        app:backgroundTint="#004466"
        app:cornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/status_cards" />

</androidx.constraintlayout.widget.ConstraintLayout>
